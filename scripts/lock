#!/usr/bin/env bash
set -euo pipefail

tmpdir="$(mktemp -d)"
dirty=0
# Marker for the moment of the last unlock; see the cooldown guard below.
stamp="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/swaylock-unlocked"

# Snapshot animation state so we can restore it on the way out.
ANIMS_ENABLED="$(hyprctl getoption animations:enabled | awk 'NR==1{print $2}')" || ANIMS_ENABLED=1

restore() {
  if [ "$dirty" = 1 ]; then
    touch "$stamp"                               # stamp the unlock so an immediate re-lock is suppressed
    show-desktop || true
    [ "${ANIMS_ENABLED:-1}" = 1 ] && hyprctl -q keyword animations:enabled 1 || true
  fi
  rm -rf "$tmpdir"
}
trap restore EXIT

# Already locked? Do nothing (and don't disturb the desktop).
pgrep -x swaylock > /dev/null && exit 0

# Suppress a re-lock that lands right after a successful unlock. swayidle runs
# with -w, so it blocks on the foreground swaylock and stops draining its Wayland
# event loop while we're locked; an idle `timeout` that fires during a long lock
# gets buffered and replayed the instant swaylock exits, re-locking the screen a
# few seconds after unlock. The pgrep guard above can't catch it (swaylock is
# already gone by then), so ignore lock requests within 5s of the last unlock.
if [ -f "$stamp" ] && [ "$(( $(date +%s) - $(stat -c %Y "$stamp") ))" -lt 5 ]; then
  exit 0
fi

dirty=1
hyprctl -q keyword animations:enabled 0
show-desktop                                   # hide windows so the lock bg is a clean desktop

# Per-output screenshots for the lock background.
mapfile -t outputs < <(hyprctl -j monitors | jq -r '.[].name')
args=()
for out in "${outputs[@]}"; do
  img="$tmpdir/$out.png"
  grim -o "$out" "$img"
  args+=( --image "$out:$img" )
done

# Foreground swaylock in a memory-capped transient scope. MemoryMax is a hard backstop so a
# runaway is cgroup-killed (screen unlocks) long before it can OOM the machine — the old
# failure mode (swaylock-effects leaked to ~30 GB via --clock). MemorySwapMax=0 stops it
# thrashing swap on the way there.
systemd-run --user --scope --collect \
  -p MemoryMax=1G -p MemorySwapMax=0 \
  -- swaylock \
    --indicator-idle-visible \
    --indicator-radius 120 --indicator-thickness 8 \
    --line-color 282A36 --ring-color BD93F9 --inside-color 282A36 \
    --key-hl-color 50FA7B --separator-color 00000000 --text-color F8F8F2 \
    --text-caps-lock-color="" \
    --line-ver-color BD93F9 --ring-ver-color BD93F9 --inside-ver-color 282A36 --text-ver-color 8BE9FD \
    --ring-wrong-color FF5555 --text-wrong-color FF5555 --inside-wrong-color 282A36 --line-wrong-color 282A36 \
    --inside-clear-color 282A36 --text-clear-color 8BE9FD --ring-clear-color 8BE9FD --line-clear-color 8BE9FD \
    --bs-hl-color 8BE9FD \
    --font "Fira Mono" \
    --show-failed-attempts --ignore-empty-password \
    "${args[@]}"

# Unlocked here; restore handled by EXIT trap.
