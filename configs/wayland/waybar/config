{
    "layer": "top",
    "position": "top",
    "reload_style_on_change": true,
    "modules-left": ["clock","hyprland/language","tray","custom/keychron","custom/gpro-batt", "mpris"],
    "modules-center": ["hyprland/workspaces"],
    "modules-right": ["group/audio", "group/system", "network", "group/expand-power"],


    "hyprland/workspaces": {
        "format": "{icon}",
        "format-icons": {
            "active": "",
            "default": "",
            "empty": ""
        },
        "persistent-workspaces": {
            "*": [ 1,2,3,4,5 ]
        }
    },
    "hyprland/language": {
        "format": "{} ",
        "format-en": "EN",
        "format-ru": "RU",
        "on-click": "hyprctl switchxkblayout keychron--keychron-link--keyboard next"
    },
    "clock": {
        "format": "{:%B %d %I:%M:%S %p}",
        "interval": 1,
        "tooltip-format": "<span font-family='JetBrainsMono Nerd Font' size='10pt'>{calendar}</span>",
        "calendar": {
            "mode": "month",
            "format": {
            "today": "<span fgcolor='#ffcc66' bgcolor='#3b4252'><b><u>{}</u></b></span>"
            }
        },
        "actions": {
            "on-click-right": "shift_down",
            "on-click": "shift_up"
        }
        },
    "network": {
        "format-wifi": "",
        "format-ethernet":"",
        "format-disconnected": "",
        "tooltip-format-disconnected": "Error",
        "tooltip-format-wifi": "{essid} ({signalStrength}%) ",
        "tooltip-format-ethernet": "{ifname} 🖧 ",
        "on-click": "kitty nmtui"
    },
    "custom/expand": {
        "format": "",
        "tooltip": false
    },
    "custom/endpoint":{
        "format": "|",
        "tooltip": false
    },
    "custom/shutdown": {
        "format": "󰐥",
        "on-click": "shutdown now"
    },
    "group/expand": {
        "orientation": "horizontal",
        "drawer": {
            "transition-duration": 600,
            "transition-to-left": true,
            "click-to-reveal": true
        },
        "modules": ["custom/expand", "custom/colorpicker","cpu","memory","temperature","custom/endpoint"]
    },
    "group/expand-power": {
        "orientation": "vertical",
        "drawer": {
            "transition-duration": 600,
            "transition-to-left": true,
            "click-to-reveal": true
        },
        "modules": ["custom/shutdown"]
    },
    "group/audio": {
        "orientation": "horizontal",
        "modules": ["pulseaudio", "custom/micmute"]
    },
    "group/system": {
        "orientation": "horizontal",
        "modules": ["cpu", "memory", "temperature", "custom/gpu-temp"]
    },
    "custom/colorpicker": {
        "format": "{}",
        "return-type": "json",
        "interval": "once",
        "exec": "~/.config/waybar/scripts/colorpicker.sh -j",
        "on-click": "~/.config/waybar/scripts/colorpicker.sh",
        "signal": 1
    },
    "cpu": {
        "format": "{usage}%󰻠",
        "tooltip": true
    },
    "custom/gpu-temp": {
        "exec": "bash -lc 't=$(nvidia-smi --query-gpu=temperature.gpu --format=csv,noheader,nounits 2>/dev/null | head -n1 | tr -dc 0-9); echo \"${t}\"'",
        "interval": 2,
        "tooltip": true
    },
    "memory": {
        "format": "{used}"
    },
    "temperature": {
        "critical-threshold": 80,
        "format": "{temperatureC}"
    },
    "tray": {
        "icon-size": 14,
        "spacing": 10
    },
    "custom/gpro-batt": {
        "exec": "~/.config/waybar/scripts/gpro-battery",
        "return-type": "json",
        "interval": 60
    },
    "custom/keychron": {
        "exec": "~/.config/waybar/scripts/kc-battery",
        "return-type": "json",
        "interval": 60
    },
    "mpris": {
        "interval": 2,
        "format": "{player_icon} {title} - {artist}",
        "format-paused": "  {title} - {artist}",
        "format-stopped": " ",
        "player-icons": {
        "default": "",
        "spotify": "",
        "mpv": "",
        "vlc": "嗢"
        },
        "max-length": 80,
        "tooltip": true,
        "tooltip-format": "{player}\n{title}\n{artist}\n{album}",
        "on-click": "playerctl play-pause",
        "on-click-right": "playerctl next",
        "on-click-middle": "playerctl previous",
        "on-scroll-up": "playerctl position 5+",
        "on-scroll-down": "playerctl position 5-"
    },
    "pulseaudio": {
        "format": "{volume}%{icon}",
        "format-muted": "󰖁",
        "format-icons": {
        "headphone": "󰋋",
        "headset": "󰋎",
        "speaker": "󰕾",
        "default": ["󰕿", "󰖀", "󰕾"]
        },
        "scroll-step": 5,
        "on-click": "pavucontrol"
    },
    "custom/micmute": {
        "return-type": "json",
        "interval": "once",
        "signal": 8,
        "exec": "bash -lc 'out=\"$(wpctl get-volume @DEFAULT_AUDIO_SOURCE@ 2>/dev/null || true)\"; if printf \"%s\" \"$out\" | grep -q MUTED; then echo \"{\\\"text\\\":\\\"󰍭\\\",\\\"tooltip\\\":\\\"Mic muted\\\",\\\"class\\\":\\\"muted\\\"}\"; else echo \"{\\\"text\\\":\\\"󰍬\\\",\\\"tooltip\\\":\\\"Mic live\\\",\\\"class\\\":\\\"unmuted\\\"}\"; fi'",
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle; pkill -RTMIN+8 waybar",
        "tooltip": true
    }
}