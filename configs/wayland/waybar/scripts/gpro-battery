#!/usr/bin/env sh

DEV=/org/freedesktop/UPower/devices/battery_hidpp_battery_0;

INFO="$(upower -i "$DEV" 2>/dev/null)"
PCT="$(printf '%s\n' "$INFO" | awk -F': *' '/percentage/ {gsub("%","",$2); print int($2); exit}')"
STATE="$(printf '%s\n' "$INFO" | awk -F': *' '/state/ {print $2; exit}')"
MODEL="$(printf '%s\n' "$INFO" | awk -F': *' '/model/ {print $2; exit}')"

# Not present / not readable / reporting 0% -> hide the module (empty output)
if [ -z "$PCT" ] || [ "$PCT" -eq 0 ]; then
  exit 0
fi

CLASS="green"
if [ "$PCT" -gt 50 ]; then
  CLASS="green"
elif [ "$PCT" -gt 25 ]; then
  CLASS="orange"
else
  CLASS="red"
fi

# Show a bolt while charging; keep the level color and add a "charging"
# class so CSS can target it without losing the green/orange/red color.
ICON="🖱️"
CLASS_JSON="\"$CLASS\""
case "$STATE" in
  charging|pending-charge)
    ICON="🖱️⚡"
    CLASS_JSON="[\"$CLASS\",\"charging\"]"
    ;;
esac

printf '{"text":"%s%s%%","class":%s,"tooltip":"%s (%s)"}\n' "$ICON" "$PCT" "$CLASS_JSON" "${MODEL:-Mouse}" "${STATE:-unknown}"
