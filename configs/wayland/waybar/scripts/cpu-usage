#!/usr/bin/env sh
# Bar text: overall CPU usage %. Tooltip: top 3 processes by CPU.

read_stat() {
  awk '/^cpu /{idle=$5+$6; total=0; for(i=2;i<=NF;i++) total+=$i; print total, idle}' /proc/stat
}

set -- $(read_stat); t1=$1; i1=$2
sleep 0.4
set -- $(read_stat); t2=$1; i2=$2

dt=$((t2 - t1)); di=$((i2 - i1))
if [ "$dt" -gt 0 ]; then
  usage=$(( (100 * (dt - di) + dt / 2) / dt ))
else
  usage=0
fi

# Top 3 by CPU; \n separates lines in the tooltip, comm is sanitized for JSON.
tip=$(ps -eo %cpu,comm --sort=-%cpu --no-headers 2>/dev/null | head -3 \
  | awk '{name=$2; gsub(/["\\]/,"",name); printf "%5.1f%%  %s\\n", $1, name}')
tip=$(printf '%s' "$tip" | sed 's/\\n$//')

gap="<span size='5pt'> </span>"
printf '{"text":"%3s%%%s󰻠","tooltip":"CPU — top 3 processes\\n%s"}\n' "$usage" "$gap" "$tip"
